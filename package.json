{
  "name": "tesla-remote",
  "author": "Tesla Remote contributors",
  "version": "0.1.0",
  "keywords": ["pebble-app", "tesla"],
  "private": true,
  "dependencies": {},
  "pebble": {
    "displayName": "Tesla Remote",
    "uuid": "7d4c2a6e-3f1b-4c8e-9a5d-2b6f8e1c4a70",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": ["basalt", "chalk", "diorite", "emery", "flint", "gabbro"],
    "capabilities": ["configurable"],
    "watchapp": { "watchface": false },
    "messageKeys": [
      "Type", "Cmd", "Value", "Text", "CarState", "HasData", "Battery", "Range", "Charging",
      "ChargeLimit", "MinutesToFull", "Locked", "Frunk", "Trunk", "Climate", "InTemp", "OutTemp",
      "SetTemp", "Defrost", "SeatHeat", "Units", "Model", "Age", "CarName"
    ],
    "resources": {
      "media": [
        { "type": "bitmap", "name": "MENU_ICON", "file": "images/menu_icon.png", "menuIcon": true }
      ]
    }
  }
}
